# Copie este arquivo para ".env" e preencha os valores.
# O .env NUNCA deve ir para o git (já está no .gitignore).

# Token entregue pelo @BotFather ao criar o bot
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Seu chat id. O bot ignora mensagens de qualquer outro chat.
# Descubra o seu falando com o @userinfobot no Telegram.
ALLOWED_CHAT_ID=123456789

# Opcionais (valores padrão abaixo)
DATABASE_PATH=data/finbot.db
TIMEZONE=America/Sao_Paulo

# --- Saúde financeira (/saude) ---
# Categorias consideradas gastos fixos (separadas por vírgula)
FIXED_CATEGORIES=moradia,saúde,educação
# Faixas do comprometimento da renda com parcelas (em %):
# até HEALTH_OK_MAX = saudável; até HEALTH_WARN_MAX = atenção; acima = alerta
HEALTH_OK_MAX=30
HEALTH_WARN_MAX=40
# Sugestões: categoria que cresceu pelo menos X% E pelo menos R$ Y em relação
# à média dos 3 meses anteriores; a sugestão manda Z% do aumento para a dívida.
SUGGEST_MIN_GROWTH_PCT=20
SUGGEST_MIN_GROWTH_BRL=50
SUGGEST_SHARE_PCT=50

# --- Lembretes de vencimento ---
# Hora do dia (0 a 23, no seu fuso) e quantos dias antes do vencimento
REMINDER_HOUR=9
REMINDER_DAYS_BEFORE=3
